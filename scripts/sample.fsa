fn addition:
    grow_stack 0x1
    load_arg 0x0
    load_arg 0x1
    add
    retv 0x3

fn substraction:
    grow_stack 0x1
    load_arg 0x0
    load_arg 0x1
    sub
    retv 0x2

export fn entry:
    push 0x1
    push 0x1
    call addition
    ret 0x0

export fn caller:
    call call_forward
    ret 0x0

export fn jumper:
    push 0x0
    jmp target
    push 0x1
target:
    push 0x2
    ret 0x0

export fn string_loader:
    push 0x1
    lstr "test"
    ret 0x0

fn call_forward:
    ret 0x0
